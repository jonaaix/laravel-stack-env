# Stack environment defaults
#
# This file belongs in version control and applies to everyone working on this project.
# It holds the values the project's stack dictates — database driver, service hostnames,
# ports, queue and mail transport — so a fresh checkout is configured out of the box.
#
# Precedence, highest first:
#   1. real environment variables (container, shell, CI)
#   2. .env            the developer's own file, not in version control
#   3. .env.stack      this file
#   4. the env() fallback in config/*.php
#
# To override a value locally, put the key in your own .env — it wins over this file.
# Keys defined here do not belong in .env.example.

# DB_CONNECTION=mysql
